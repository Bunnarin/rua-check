{
	"name": "rua-check",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"kv_namespaces": [
		{
			// Create with: wrangler kv namespace create RATE_LIMIT
			"binding": "RATE_LIMIT",
			"id": "rua-check-rate-limit"
		}
	]
}